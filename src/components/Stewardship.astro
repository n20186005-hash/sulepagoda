---
import { getI18n } from '../i18n/ui';

const { messages } = getI18n(Astro.url);
const s = messages.stewardship ?? {};
const science = s.scienceItems ?? [];
const duties = s.responsibilityItems ?? [];
---

<section id="stewardship" class="section-padding" style="background: var(--bg-primary);">
  <div class="max-w-6xl mx-auto px-4">
    {s.eyebrow && (
      <p class="text-xs uppercase tracking-[0.22em] mb-3 text-center" style="color: var(--text-muted);">{s.eyebrow}</p>
    )}
    <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-3 text-center" style="color: var(--text-primary);">{s.title}</h2>
    {s.subtitle && (
      <p class="text-center text-base mb-10 max-w-3xl mx-auto leading-relaxed" style="color: var(--text-secondary);">{s.subtitle}</p>
    )}

    <h3 class="font-display text-2xl font-semibold mb-4" style="color: var(--text-primary);">{s.scienceHeading}</h3>
    <div class="grid sm:grid-cols-2 gap-4 mb-12">
      {science.map((item) => (
        <article class="rounded-2xl border p-5" style="background: var(--card-bg); border-color: var(--border-color);">
          <h4 class="font-display text-base font-semibold mb-2" style="color: var(--text-primary);">
            <span class="mr-2" aria-hidden="true">{item.icon}</span>{item.title}
          </h4>
          <p class="text-sm leading-relaxed" style="color: var(--text-secondary);">{item.text}</p>
        </article>
      ))}
    </div>

    <h3 class="font-display text-2xl font-semibold mb-4" style="color: var(--text-primary);">{s.responsibilityHeading}</h3>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
      {duties.map((duty) => (
        <article class="rounded-2xl border p-5 flex flex-col h-full" style="background: var(--card-bg); border-color: var(--border-color);">
          <span class="text-xl leading-none mb-2" aria-hidden="true">{duty.icon}</span>
          <h4 class="font-display text-base font-semibold mb-2" style="color: var(--text-primary);">{duty.title}</h4>
          <p class="text-sm leading-relaxed" style="color: var(--text-secondary);">{duty.text}</p>
        </article>
      ))}
    </div>

    {s.whyText && (
      <div class="rounded-2xl border p-6" style="background: var(--card-bg); border-color: var(--border-color);">
        <p class="text-sm font-semibold mb-2" style="color: var(--text-primary);">{s.whyLabel}</p>
        <p class="text-sm sm:text-base leading-relaxed" style="color: var(--text-secondary);">{s.whyText}</p>
      </div>
    )}
  </div>
</section>

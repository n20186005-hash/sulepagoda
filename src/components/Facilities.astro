---
import { getI18n } from '../i18n/ui';

const { messages } = getI18n(Astro.url);
const f = messages.facilities ?? {};
const items = f.items ?? [];
---

<section id="facilities" class="section-padding" style="background: var(--bg-primary);">
  <div class="max-w-6xl mx-auto px-4">
    {f.eyebrow && (
      <p class="text-xs uppercase tracking-[0.22em] mb-3 text-center" style="color: var(--text-muted);">{f.eyebrow}</p>
    )}
    <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-3 text-center" style="color: var(--text-primary);">{f.title}</h2>
    {f.subtitle && (
      <p class="text-center text-base mb-4 max-w-3xl mx-auto leading-relaxed" style="color: var(--text-secondary);">{f.subtitle}</p>
    )}
    {f.neutralNote && (
      <p class="text-center text-xs mb-9 max-w-3xl mx-auto leading-relaxed rounded-full px-4 py-2 border" style="color: var(--text-muted); border-color: var(--border-color); background: var(--bg-secondary);">
        {f.neutralNote}
      </p>
    )}

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {items.map((item) => (
        <article class="rounded-2xl border p-5 flex flex-col h-full" style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);">
          <span class="text-2xl mb-3 leading-none" aria-hidden="true">{item.icon}</span>
          <h3 class="font-display text-lg font-semibold mb-2" style="color: var(--text-primary);">{item.title}</h3>
          <p class="text-sm leading-relaxed" style="color: var(--text-secondary);">{item.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

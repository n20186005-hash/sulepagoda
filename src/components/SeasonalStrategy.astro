---
import { getI18n } from '../i18n/ui';

const { messages } = getI18n(Astro.url);
const c = messages.climate ?? {};
const head = c.tableHead ?? {};
const rows = c.rows ?? [];
const indices = c.indices ?? [];
---

<section id="seasons" class="section-padding" style="background: var(--bg-secondary);">
  <div class="max-w-6xl mx-auto px-4">
    {c.eyebrow && (
      <p class="text-xs uppercase tracking-[0.22em] mb-3 text-center" style="color: var(--text-muted);">{c.eyebrow}</p>
    )}
    <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-3 text-center" style="color: var(--text-primary);">{c.title}</h2>
    {c.subtitle && (
      <p class="text-center text-base mb-9 max-w-3xl mx-auto leading-relaxed" style="color: var(--text-secondary);">{c.subtitle}</p>
    )}

    <!-- 季度游览策略表 -->
    <div class="overflow-x-auto rounded-2xl border mb-8" style="border-color: var(--border-color); background: var(--card-bg);">
      <table class="w-full min-w-[46rem] text-left text-sm align-top">
        <thead>
          <tr style="background: var(--bg-primary);">
            <th scope="col" class="px-4 py-3 font-semibold" style="color: var(--text-primary);">{head.season}</th>
            <th scope="col" class="px-4 py-3 font-semibold" style="color: var(--text-primary);">{head.months}</th>
            <th scope="col" class="px-4 py-3 font-semibold" style="color: var(--text-primary);">{head.temperature}</th>
            <th scope="col" class="px-4 py-3 font-semibold" style="color: var(--text-primary);">{head.rainfall}</th>
            <th scope="col" class="px-4 py-3 font-semibold" style="color: var(--text-primary);">{head.strategy}</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr class="border-t" style="border-color: var(--border-color);">
              <th scope="row" class="px-4 py-4 font-semibold align-top whitespace-nowrap" style="color: var(--text-primary);">{row.season}</th>
              <td class="px-4 py-4 align-top whitespace-nowrap" style="color: var(--text-secondary);">{row.months}</td>
              <td class="px-4 py-4 align-top whitespace-nowrap" style="color: var(--text-secondary);">{row.temperature}</td>
              <td class="px-4 py-4 align-top whitespace-nowrap" style="color: var(--text-secondary);">{row.rainfall}</td>
              <td class="px-4 py-4 align-top leading-relaxed" style="color: var(--text-secondary);">{row.strategy}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- 环境条件综合分析 -->
    {indices.length > 0 && (
      <>
        <h3 class="font-display text-xl font-semibold mb-4" style="color: var(--text-primary);">{c.indicesLabel}</h3>
        <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-3">
          {indices.map((index) => (
            <div class="rounded-2xl border p-4" style="background: var(--card-bg); border-color: var(--border-color);">
              <span class="text-xl leading-none" aria-hidden="true">{index.icon}</span>
              <p class="text-xs uppercase tracking-[0.14em] mt-2" style="color: var(--text-muted);">{index.label}</p>
              <p class="text-sm font-semibold mt-1" style="color: var(--text-primary);">{index.value}</p>
              <p class="text-xs mt-2 leading-relaxed" style="color: var(--text-secondary);">{index.note}</p>
            </div>
          ))}
        </div>
      </>
    )}

    {c.methodNote && (
      <p class="text-xs mt-6 leading-relaxed" style="color: var(--text-muted);">{c.methodNote}</p>
    )}
  </div>
</section>

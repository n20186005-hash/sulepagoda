---
import '../styles/global.css';
import Header from '../components/Header.astro';
import NoticeBanner from '../components/NoticeBanner.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, buildAlternates, htmlLangAttr, getI18n } from '../i18n/ui';
import { ogLocale, siteConfig, entityConfig } from '../config';

interface Props {
  title: string;
  description: string;
  path?: string;
  /** 覆盖默认 robots 指令，法律/设置页传入 'noindex, follow' */
  robots?: string;
  /** 是否输出景点实体结构化数据；非景点主题页应关闭，避免实体信号与页面主题冲突 */
  entityLd?: boolean;
}

const { title, description, path = '', robots, entityLd = true } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const htmlLang = htmlLangAttr(lang);
const alts = buildAlternates(path);
const canonical = alts[lang] ?? alts.zh;
const { messages } = getI18n(Astro.url);
const attractionName = messages.header?.siteName ?? messages.footer?.siteName ?? messages.meta.title;

// hreflang 值与 <html lang> 保持一致（zh → zh-CN），便于 Google 按语种精确匹配
const hreflangLinks = siteConfig.locales.map((code) => ({
  code: htmlLangAttr(code),
  href: alts[code],
}));

// 站点与实体绑定（见 src/config.ts 变量表）
const siteUrl = siteConfig.baseUrl.replace(/\/+$/, '');
const abs = (p: string) => `${siteUrl}${p.startsWith('/') ? p : '/' + p}`;
const ogImage = abs(entityConfig.heroImage);
const heroAlt = `${entityConfig.attractionFullName} in ${entityConfig.cityName}`;

const jsonLd = {
  '@context': 'https://schema.org',
  // 复合类型：TouristAttraction 提供景点语义，Place 提供地理/地址语义，两者叠加覆盖面更广
  '@type': ['TouristAttraction', 'Place'],
  '@id': `${siteUrl}/#attraction`,
  name: entityConfig.attractionFullName,
  alternateName: [
    entityConfig.attractionShortName,
    `${entityConfig.cityName} ${entityConfig.attractionFullName}`,
    entityConfig.attractionNativeName,
    ...entityConfig.alternateNames,
    attractionName,
  ],
  description: messages.meta.description,
  url: canonical,
  mainEntityOfPage: canonical,
  image: entityConfig.galleryImages.map(abs),
  address: {
    '@type': 'PostalAddress',
    streetAddress: entityConfig.streetAddress,
    addressLocality: entityConfig.cityName,
    addressRegion: entityConfig.stateProvince,
    postalCode: entityConfig.postalCode,
    addressCountry: entityConfig.countryCode,
  },
  telephone: entityConfig.telephone,
  geo: {
    '@type': 'GeoCoordinates',
    latitude: entityConfig.latitude,
    longitude: entityConfig.longitude,
  },
  hasMap: entityConfig.mapsShareUrl,
  containedInPlace: {
    '@type': 'City',
    name: entityConfig.cityName,
    address: {
      '@type': 'PostalAddress',
      addressLocality: entityConfig.cityName,
      addressRegion: entityConfig.stateProvince,
      addressCountry: entityConfig.countryCode,
    },
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: entityConfig.openingHours.opens,
      closes: entityConfig.openingHours.closes,
    },
  ],
  // 本地信众免费、外国游客需在入口购票，故不声明 isAccessibleForFree / 免费 Offer，避免与事实冲突
  publicAccess: true,
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: entityConfig.rating.value,
    reviewCount: String(entityConfig.rating.count),
    bestRating: entityConfig.rating.best,
    worstRating: entityConfig.rating.worst,
  },
  sameAs: [
    entityConfig.rating.sourceUrl,
    entityConfig.govtTourismUrl,
    'https://en.wikipedia.org/wiki/Sule_Pagoda',
  ],
};

const breadcrumbLd = (() => {
  const bc = messages.breadcrumb;
  return {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: bc.home, item: `${siteConfig.baseUrl}/${lang}` },
      { '@type': 'ListItem', position: 2, name: bc.region, item: `${siteConfig.baseUrl}/${lang}#overview` },
      { '@type': 'ListItem', position: 3, name: bc.city, item: `${siteConfig.baseUrl}/${lang}#transport` },
      { '@type': 'ListItem', position: 4, name: bc.current, item: canonical },
    ],
  };
})();
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    {hreflangLinks.map((link) => (
      <link rel="alternate" hreflang={link.code} href={link.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={alts.xDefault} />

    <meta property="og:site_name" content={entityConfig.attractionFullName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[lang] ?? lang} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={heroAlt} />
    <meta property="og:image:width" content={String(entityConfig.heroImageWidth)} />
    <meta property="og:image:height" content={String(entityConfig.heroImageHeight)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={heroAlt} />

    <!-- PWA -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0f2015" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={entityConfig.attractionFullName} />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icon-180.png" />

    <meta name="google-adsense-account" content="ca-pub-XXXXXXXXXX" />
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXX" crossorigin="anonymous"></script>

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HXM22WWPKP');
    </script>

    {entityLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>}
    {entityLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)}></script>}

    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('theme');
          if (theme === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
          }
        } catch (e) {}
      })();
    </script>

    <slot name="head" />
  </head>
  <body class="min-h-screen">
    <Header />
    <NoticeBanner />
    <main>
      <slot />
    </main>
    <Footer />
    <script is:inline>
      (function () {
        if (!('serviceWorker' in navigator)) return;
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js', { scope: '/' }).catch(function () {});
        });
      })();
    </script>
  </body>
</html>

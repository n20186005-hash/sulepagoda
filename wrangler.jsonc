{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sulepagoda",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "placement": {
    "mode": "smart",
  },
  "vars": {
    "SITE_URL": "https://sulepagoda.org",
  },
}
